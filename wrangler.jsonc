{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "samaguri-satra-website",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "exclude": ["**/majuli.mp4", "assets/majuli.mp4"]
  },
  "vars": {
    "NODE_ENV": "production"
  }
}