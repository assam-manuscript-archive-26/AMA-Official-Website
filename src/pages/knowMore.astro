---
import BaseLayout from '../layouts/BaseLayout.astro';
import KnowMorePage from '../components/react/sections/KnowMorePage';
import KnowMoreCollections from '../components/react/sections/knowMoreCollections';
import { getArticleById } from '../data/knowMoreData';

const id = Astro.url.searchParams.get('id');
const article = id ? getArticleById(id) : undefined;

const pageTitle = article ? article.title : "Learn More";
const pageDescription = article ? article.excerpt : "Discover the history of Majuli, Sattras, and Assamese manuscript painting traditions. Learn about the rich cultural heritage of Assam's monastic institutions.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  keywords="learn more, Majuli history, Sattra traditions, manuscript painting history, Vaishnavite culture, Assamese cultural heritage, Sankardeva, Madhavdeva"
>
  {id ? <KnowMorePage client:load /> : <KnowMoreCollections client:load />}
</BaseLayout>


