---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHero from '../components/react/hero/LandingHero';
import MajuliIntro from '../components/react/sections/MajuliIntro';
import CollectionsCarousel from '../components/react/sections/CollectionsCarousel';
---

<BaseLayout
  title="Home"
  description="Discover the digital archive of Assamese manuscript paintings. Explore ancient manuscripts, Sattras, and cultural heritage from Majuli, Assam."
  keywords="Assamese manuscripts, manuscript paintings, Majuli, Sattra, Vaishnavite art, ancient manuscripts, digital archive, Assam culture, traditional painting"
>

  <!-- Hero Section (with integrated search bar) -->
  <LandingHero client:load />

  <!-- Welcome to Majuli Section -->
  <MajuliIntro client:visible />

  <!-- EXPLORE OUR COLLECTIONS -->
  <CollectionsCarousel client:visible />

</BaseLayout>

<style>
  /* Additional spacing for mobile bottom nav */
  .safe-area-pb {
    padding-bottom: env(safe-area-inset-bottom, 0);
  }
</style>