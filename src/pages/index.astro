---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHero from '../components/react/hero/LandingHero';
import MajuliIntro from '../components/react/sections/MajuliIntro';
import CollectionsCarousel from '../components/react/sections/CollectionsCarousel';
import HomeFAQ from '../components/astro/HomeFAQ.astro';
import { faqSchema } from '../data/faqs';
---

<BaseLayout
  title="Assamese Manuscript Archive | Samaguri Satra Heritage & Ancient Art"
  description="Explore the digital archive of Assamese manuscript paintings, sacred Sanchipat texts, and traditional mask making from Samaguri Satra in Majuli, Assam."
  keywords="Assamese manuscripts, manuscript paintings, Samaguri Satra, Chamaguri Satra, Majuli, Sanchipat, Vaishnavite art, ancient manuscripts, digital archive, Assam culture, Bhaona masks"
  schema={[faqSchema]}
>

  <!-- Hero Section (with integrated search bar) -->
  <LandingHero client:load />

  <!-- Welcome to Majuli Section -->
  <MajuliIntro client:visible />

  <!-- EXPLORE OUR COLLECTIONS -->
  <CollectionsCarousel client:visible />

  <!-- Answer Engine Optimization (AEO) FAQs with FAQPage Schema -->
  <!-- <HomeFAQ /> -->

</BaseLayout>

<style>
  /* Additional spacing for mobile bottom nav */
  .safe-area-pb {
    padding-bottom: env(safe-area-inset-bottom, 0);
  }
</style>