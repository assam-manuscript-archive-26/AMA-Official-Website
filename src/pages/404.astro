---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist. Explore our collections or return home to discover the Assamese Manuscript Archive."
  keywords="404, page not found, error page, broken link"
  noIndex={true}
>
  <section class="py-24 px-6 min-h-[60vh] flex items-center justify-center">
    <div class="text-center">
      <h1 class="font-display text-8xl text-ink mb-4">404</h1>
      <p class="text-body text-xl mb-8">Page not found</p>
      <a href="/" class="btn-primary">Return Home</a>
    </div>
  </section>
</BaseLayout>