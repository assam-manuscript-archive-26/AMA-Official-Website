---
import ProfessionalFooter from '@/components/react/sections/ProfessionalFooter';
import ThemeInit from '../components/react/theme-toggle/ThemeInit.astro';
import FloatingNavbar from '@/components/react/navbar/FloatingNavbar';
import { Chatbot } from '@/components/react';
import FloatingQRButton from '@/components/react/floatingButton/FloatingQRButton';
import SEO from '../components/astro/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  noIndex?: boolean;
  noFollow?: boolean;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'Assamese Manuscript Archive',
  description = 'Digital archive of Assamese manuscript paintings - preserving the cultural heritage of Assam through digital preservation of ancient manuscripts and paintings from Majuli and Sattras.',
  keywords = 'Assamese manuscripts, manuscript painting, Sattra, Majuli, Assam culture, Vaishnavite manuscripts, ancient manuscripts, digital archive, cultural heritage',
  image,
  noIndex = false,
  noFollow = false,
  schema
} = Astro.props;

const fullTitle = title.includes('Assamese Manuscript Archive')
  ? title
  : `${title} | Assamese Manuscript Archive`;

const currentUrl = Astro.url.pathname + (Astro.url.search || '');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Preconnect for Google Fonts to eliminate render-blocking CSS -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <title>{fullTitle}</title>
    <SEO
      title={fullTitle}
      description={description}
      keywords={keywords}
      image={image}
      url={currentUrl}
      noIndex={noIndex}
      noFollow={noFollow}
      schema={schema}
    />
    <ThemeInit />
  </head>
  <body class="bg-canvas text-ink min-h-screen flex flex-col">
    <!-- Grain texture overlay - full page background -->
    <div
      class="fixed inset-0 pointer-events-none -z-10"
      style={{
        backgroundImage: "url('https://www.transparenttextures.com/patterns/tileable-wood-colored.png')",
        opacity: 0.45,
      }}
    ></div>
    <!-- Floating Navbar -->
    <FloatingNavbar client:load initialPath={Astro.url.pathname} />
    <main class="flex-1 relative z-10">
      <slot />
    </main>
    <!-- Professional Footer -->
    <ProfessionalFooter client:visible />
    <!-- Floating QR Button -->
    <FloatingQRButton client:load />
    <!-- Chatbot -->
    <Chatbot client:load />
  </body>
</html>

<style is:global>
  @import '../globals.css';
</style>