---
import Navbar from '../components/astro/Navbar.astro';
import SEO from '../components/astro/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  noIndex?: boolean;
  noFollow?: boolean;
}

const {
  title = 'Assamese Manuscript Archive',
  description = 'Digital archive of Assamese manuscript paintings - preserving the cultural heritage of Assam through digital preservation of ancient manuscripts and paintings from Majuli and Sattras.',
  keywords = 'Assamese manuscripts, manuscript painting, Sattra, Majuli, Assam culture, Vaishnavite manuscripts, ancient manuscripts, digital archive, cultural heritage',
  image,
  noIndex = false,
  noFollow = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title ? `${title} | ` : ''}Assamese Manuscript Archive</title>
    <SEO
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      url={Astro.url.pathname}
      noIndex={noIndex}
      noFollow={noFollow}
    />
  </head>
  <body class="bg-canvas text-ink min-h-screen">
    <Navbar />
    <slot />
  </body>
</html>

<style is:global>
  @import '../globals.css';
</style>