---
import Navbar from '../components/astro/Navbar.astro';
import SEO from '../components/astro/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  noIndex?: boolean;
  noFollow?: boolean;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'Assamese Manuscript Archive',
  description = 'Digital archive of Assamese manuscript paintings - preserving the cultural heritage of Assam through digital preservation of ancient manuscripts and paintings from Majuli and Sattras.',
  keywords = 'Assamese manuscripts, manuscript painting, Sattra, Majuli, Assam culture, Vaishnavite manuscripts, ancient manuscripts, digital archive, cultural heritage',
  image,
  noIndex = false,
  noFollow = false,
  schema
} = Astro.props;

const fullTitle = title.includes('Assamese Manuscript Archive')
  ? title
  : (title ? `${title} | Assamese Manuscript Archive` : 'Assamese Manuscript Archive');

const currentUrl = Astro.url.pathname + (Astro.url.search || '');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Preconnect for Google Fonts to eliminate render-blocking CSS -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <title>{fullTitle}</title>
    <SEO
      title={fullTitle}
      description={description}
      keywords={keywords}
      image={image}
      url={currentUrl}
      noIndex={noIndex}
      noFollow={noFollow}
      schema={schema}
    />
  </head>
  <body class="bg-canvas text-ink min-h-screen">
    <Navbar />
    <slot />
  </body>
</html>

<style is:global>
  @import '../globals.css';
</style>