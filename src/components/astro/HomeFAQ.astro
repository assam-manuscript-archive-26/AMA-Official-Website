---
import { faqs } from '../../data/faqs';
---

<section class="py-16 md:py-24 px-4 sm:px-6 bg-[var(--color-bg)] relative border-t border-[var(--color-hairline)]" aria-labelledby="faq-heading">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[var(--color-surface-soft)] text-[var(--color-primary)] mb-3">
        Knowledge &amp; Heritage Guide
      </div>
      <h2 id="faq-heading" class="font-display text-3xl sm:text-4xl md:text-5xl text-[var(--color-text)] font-semibold mb-4">
        Frequently Asked Questions
      </h2>
      <p class="text-[var(--color-text-secondary)] max-w-2xl mx-auto text-base sm:text-lg">
        Essential insights into Assam's manuscript painting heritage, Sanchipat preservation, and Samaguri Satra's cultural legacy.
      </p>
    </div>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="group bg-[var(--color-bg-elevated)] rounded-xl border border-[var(--color-hairline)] p-6 transition-all duration-300 open:shadow-md">
          <summary class="flex justify-between items-center cursor-pointer list-none text-lg sm:text-xl font-display font-medium text-[var(--color-text)] group-open:text-[var(--color-primary)] transition-colors">
            <span>{faq.question}</span>
            <span class="ml-4 flex-shrink-0 w-8 h-8 rounded-full bg-[var(--color-surface-soft)] flex items-center justify-center text-[var(--color-text)] transition-transform duration-300 group-open:rotate-180">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-[var(--color-hairline)] text-[var(--color-text-secondary)] leading-relaxed text-sm sm:text-base">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
