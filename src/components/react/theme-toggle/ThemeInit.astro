---
/**
 * ThemeInit.astro
 *
 * Inline script that runs BEFORE paint to prevent FOUC (Flash of Unstyled Content).
 * Reads theme preference from localStorage and sets data-theme on <html>.
 * Must be placed in <head> of every layout.
 */
---

<script is:inline>
(function() {
  var STORAGE_KEY = 'samaguri-theme';
  var stored = null;
  try { stored = localStorage.getItem(STORAGE_KEY); } catch(e) {}

  var mode = (stored === 'light' || stored === 'dark' || stored === 'system') ? stored : 'system';
  var resolved = mode;

  if (mode === 'system') {
    resolved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  document.documentElement.setAttribute('data-theme', resolved);
})();
</script>